{
  "mcpServers": {
    "server-admin": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "${CLAUDE_PLUGIN_ROOT}/mcp/server-admin",
        "python",
        "-m",
        "discord_mcp.server"
      ]
    },
    "discord": {
      "command": "bun",
      "args": [
        "run",
        "--cwd",
        "${CLAUDE_PLUGIN_ROOT}/channel",
        "--shell=bun",
        "--silent",
        "start"
      ]
    }
  }
}
