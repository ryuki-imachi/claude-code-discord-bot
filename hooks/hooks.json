{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "PATH=\"$HOME/.local/bin:/opt/homebrew/bin:$PATH\" \"${CLAUDE_PLUGIN_ROOT}/hooks/notify-clear-done.py\"",
            "statusMessage": "Discord へクリア完了を通知中"
          }
        ]
      }
    ]
  }
}
