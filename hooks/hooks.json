{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "PATH=\"$HOME/.local/bin:/opt/homebrew/bin:$PATH\" \"${CLAUDE_PLUGIN_ROOT}/hooks/notify-clear-done.py\"",
            "statusMessage": "Discord へクリア完了を通知中"
          }
        ]
      },
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "PATH=\"$HOME/.local/bin:/opt/homebrew/bin:$PATH\" \"${CLAUDE_PLUGIN_ROOT}/hooks/notify-restart-done.py\"",
            "statusMessage": "Discord へ再起動完了を通知中"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__plugin_discord-bot_server-admin__create_channel",
        "hooks": [
          {
            "type": "command",
            "command": "PATH=\"$HOME/.local/bin:/opt/homebrew/bin:$PATH\" \"${CLAUDE_PLUGIN_ROOT}/hooks/remind-channel-access.py\"",
            "statusMessage": "受信設定のリマインドを準備中"
          }
        ]
      }
    ]
  }
}
