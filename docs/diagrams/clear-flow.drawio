<mxfile host="drawio-cli"><diagram name="clear-flow" id="clear"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="1" pageWidth="1400" pageHeight="900"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="laneA" value="セッション A（/clear の前）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;dashed=1;verticalAlign=top;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="560" height="520" as="geometry"/></mxCell><mxCell id="laneB" value="セッション B（/clear の後）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;dashed=1;verticalAlign=top;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="680" y="40" width="560" height="300" as="geometry"/></mxCell><mxCell id="s1" value="1. ユーザーが Discord で /clear を送る" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=13;align=left;spacingLeft=10;" vertex="1" parent="laneA"><mxGeometry x="30" y="60" width="500" height="50" as="geometry"/></mxCell><mxCell id="s2" value="2. channel サーバーがチャンネル通知として Claude に渡す" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;align=left;spacingLeft=10;" vertex="1" parent="laneA"><mxGeometry x="30" y="140" width="500" height="50" as="geometry"/></mxCell><mxCell id="s3" value="3. Claude が返信する（クリアするね、今 54%）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=13;align=left;spacingLeft=10;" vertex="1" parent="laneA"><mxGeometry x="30" y="220" width="500" height="50" as="geometry"/></mxCell><mxCell id="s4" value="4. clear_session.sh&lt;br&gt;・マーカー ~/.claude/discord-bot/pending-clear.json を書く（chat_id）&lt;br&gt;・CLAUDE_PID と TTY から自分の tmux ペインを特定&lt;br&gt;・tmux send-keys で /clear を送る（ターン中はキューされる）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;align=left;spacingLeft=10;" vertex="1" parent="laneA"><mxGeometry x="30" y="300" width="500" height="100" as="geometry"/></mxCell><mxCell id="s5" value="5. ターンが終わり、キューされた /clear が実行される" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=13;align=left;spacingLeft=10;" vertex="1" parent="laneA"><mxGeometry x="30" y="440" width="500" height="50" as="geometry"/></mxCell><mxCell id="s6" value="6. 新しいセッションが始まる（同じプロセス、新しいセッション ID）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=13;align=left;spacingLeft=10;" vertex="1" parent="laneB"><mxGeometry x="30" y="60" width="500" height="50" as="geometry"/></mxCell><mxCell id="s7" value="7. SessionStart フック（matcher: clear）がマーカーを読む" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;align=left;spacingLeft=10;" vertex="1" parent="laneB"><mxGeometry x="30" y="140" width="500" height="50" as="geometry"/></mxCell><mxCell id="s8" value="8. REST で Discord に「クリアしたよ」を投稿し、マーカーを消す" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;align=left;spacingLeft=10;" vertex="1" parent="laneB"><mxGeometry x="30" y="220" width="500" height="50" as="geometry"/></mxCell><mxCell id="c1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;endArrow=block;endFill=1;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="s5" target="s6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="640,505 640" y="505 640,125"/></Array></mxGeometry></mxCell><mxCell id="c6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="1" source="s6" target="s7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="1" source="s7" target="s8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>
