<mxfile host="drawio-cli"><diagram name="clear-flow" id="clear"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="1" pageWidth="1400" pageHeight="900"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="laneA" value="Session A (before /clear)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;dashed=1;verticalAlign=top;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="560" height="520" as="geometry"/></mxCell><mxCell id="laneB" value="Session B (after /clear)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;dashed=1;verticalAlign=top;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="680" y="40" width="560" height="300" as="geometry"/></mxCell><mxCell id="s1" value="1. User sends /clear on Discord" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="laneA"><mxGeometry x="30" y="60" width="500" height="50" as="geometry"/></mxCell><mxCell id="s2" value="2. channel server forwards it as a channel notification" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="laneA"><mxGeometry x="30" y="140" width="500" height="50" as="geometry"/></mxCell><mxCell id="s3" value="3. Claude replies: clearing (ctx 54%)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="laneA"><mxGeometry x="30" y="220" width="500" height="50" as="geometry"/></mxCell><mxCell id="s4" value="4. clear_session.sh&lt;br&gt;- write marker ~/.claude/discord-bot/pending-clear.json (chat_id)&lt;br&gt;- find own tmux pane via CLAUDE_PID and TTY&lt;br&gt;- tmux send-keys /clear (queued while the turn runs)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="laneA